{
  "name": "@querry-kit/nuxt-ui",
  "version": "3.1.2",
  "description": "Customizable Nuxt UI table components for Query Kit",
  "keywords": [
    "nuxt",
    "nuxt-ui",
    "vue",
    "table",
    "data-table",
    "filtering",
    "sorting",
    "pagination",
    "query-kit",
    "querry-kit"
  ],
  "license": "MIT",
  "homepage": "https://querry-kit.github.io/querry-kit/docs/nuxt-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/querry-kit/nuxt-ui.git"
  },
  "bugs": {
    "url": "https://github.com/querry-kit/nuxt-ui/issues"
  },
  "author": {
    "name": "Tobias Wälde",
    "email": "business@tobiaswaelde.com",
    "url": "https://tobiaswaelde.com"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./types": {
      "types": "./dist/runtime/types/table.d.ts",
      "import": "./dist/runtime/types/table.js"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build build --stub",
    "prepack": "pnpm build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "@querry-kit/nuxt": "^0.2.0",
    "@tanstack/table-core": "^8.0.0",
    "@vueuse/core": "^14.0.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@nuxt/kit": "^4.4.0",
    "@nuxt/module-builder": "^1.0.1",
    "@nuxt/schema": "^4.4.0",
    "@nuxt/ui": "^4.10.0",
    "@querry-kit/nuxt": "^0.2.0",
    "@tanstack/table-core": "^8.21.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "happy-dom": "^20.11.1",
    "nuxt": "^4.4.0",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1"
}

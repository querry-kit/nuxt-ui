{
  "name": "@querry-kit/nuxt-ui",
  "version": "3.3.3",
  "description": "Customizable Nuxt UI table components for Query Kit",
  "keywords": [
    "nuxt",
    "nuxt-ui",
    "vue",
    "table",
    "data-table",
    "filtering",
    "sorting",
    "pagination",
    "query-kit",
    "querry-kit"
  ],
  "license": "MIT",
  "homepage": "https://querry-kit.github.io/querry-kit/docs/nuxt-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/querry-kit/nuxt-ui.git"
  },
  "bugs": {
    "url": "https://github.com/querry-kit/nuxt-ui/issues"
  },
  "author": {
    "name": "Tobias Wälde",
    "email": "business@tobiaswaelde.com",
    "url": "https://tobiaswaelde.com"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./types": {
      "types": "./dist/runtime/types/table.d.ts",
      "import": "./dist/runtime/types/table.js"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build build --stub",
    "prepack": "pnpm build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "@querry-kit/nuxt": "^0.2.0",
    "@tanstack/table-core": "^8.0.0",
    "@vueuse/core": "^14.0.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/ui": "^4.11.1",
    "@querry-kit/nuxt": "^0.2.4",
    "@tanstack/table-core": "^8.21.3",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "dependencies": {
    "vue-draggable-plus": "^0.6.1"
  }
}
